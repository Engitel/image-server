<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

	<VersionPrefix>1.6.0.0</VersionPrefix>

	<AssemblyVersion>1.6.0.0</AssemblyVersion>

	<FileVersion>1.6.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'ImageFlowDotnetServer' " />
  <ItemGroup>
    <None Remove="Imageflow.Server" />
    <None Remove="Imageflow.Server.DiskCache" />
    <None Remove="Imageflow.Server.HybridCache" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AspNetCore.LegacyAuthCookieCompat" Version="2.0.5" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Imageflow.Server" Version="0.9.0" />
    <PackageReference Include="Imageflow.Server.HybridCache" Version="0.9.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep the sibling test project out of the web app compile -->
    <Compile Remove="ImageServer.Tests/**" />
    <Content Remove="ImageServer.Tests/**" />
    <EmbeddedResource Remove="ImageServer.Tests/**" />
    <None Remove="ImageServer.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\image-server-storage\source\Imageflow.Server.Storage.Sharepoint.csproj" />
  </ItemGroup>
</Project>
